__pycache__/
*.py[cod]
*.csv
# the canonical stats reference IS tracked (CI rebuilds the page from it)
!games_2022_2026.csv
*.log
# generated reports (the live page lives in docs/ and IS tracked)
matchup.html
matchups.html
game*.html
# home-screen icon is a build artifact at the repo root, but tracked under docs/
/apple-touch-icon.png
# local tooling / preview helpers (launch.json is machine-specific; handoffs + skills are tracked)
.claude/launch.json

# generated round summary artifacts
round_email.html
round_email.txt

# same-day forum/news sentiment cache (rebuilt on demand)
.sentiment_cache.json

# spike: cached AFL API match JSON (regenerable via fetch_cba.py;
# the derived cba_games.csv is already covered by the *.csv rule above)
cba_cache/

# the per-round scorecard log IS tracked (a standing record across rounds),
# overriding the blanket *.csv ignore above
!scorecard_log.csv

# match-metadata cache for the combined-model test (regenerable via exp_joint.py)
env_meta.json

# hourly per-venue weather archive for exp_weather.py (regenerable from Open-Meteo)
weather_cache/

# point-in-time Sportsbet ladder captures (exp_drift.py log) — local time series,
# NOT regenerable; backed up via OneDrive, kept out of git to avoid churn
odds_log.jsonl

# results-page grade cache (regenerable from snapshots via results.py)
results_data.json
